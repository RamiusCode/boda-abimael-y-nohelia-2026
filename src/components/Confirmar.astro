    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 🎬 ANIMACIONES CON GSAP                                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        if (typeof window !== "undefined") {
            document.addEventListener("DOMContentLoaded", () => {
                console.log(
                    "💬 Iniciando animaciones de confirmar asistencia...",
                );


                // 🌿 RAMA IZQUIERDA: entra deslizándose desde la izquierda
                gsap.fromTo(
                    "#flor-izquierda-confirmar",
                    {
                        opacity: 0,
                        x: -90,
                        scale: 0.92,
                    },
                    {
                        opacity: 1,
                        x: 0,
                        scale: 1,
                        duration: 1.6,
                        delay: 0.35,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // 🌿 RAMA DERECHA: entra deslizándose desde la derecha
                // (rotation: 180 se mantiene fija para conservar la simetría)
                gsap.fromTo(
                    "#flor-derecha-confirmar",
                    {
                        opacity: 0,
                        x: 90,
                        scale: 0.92,
                        rotation: 180,
                    },
                    {
                        opacity: 1,
                        x: 0,
                        scale: 1,
                        rotation: 180,
                        duration: 1.6,
                        delay: 0.35,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del botón decorativo
                gsap.fromTo(
                    "#boton-decorativo-confirmar",
                    {
                        opacity: 0,
                        scale: 0,
                        rotation: -180,
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "back.out(1.7)",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación de la card
                gsap.fromTo(
                    "#card-principal-confirmar",
                    {
                        opacity: 0,
                        y: 50,
                        scale: 0.95,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del título
                gsap.fromTo(
                    "#titulo-confirmar",
                    {
                        opacity: 0,
                        y: -20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.3,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del texto
                gsap.fromTo(
                    "#texto-confirmar",
                    {
                        opacity: 0,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.5,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del botón
                gsap.fromTo(
                    "#boton-formulario-confirmar",
                    {
                        opacity: 0,
                        scale: 0.8,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.7,
                        ease: "back.out(1.5)",
                        scrollTrigger: {
                            trigger: "#card-confirmar",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación continua del botón decorativo
                gsap.to("#boton-decorativo-confirmar", {
                    y: -5,
                    duration: 2,
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                    delay: 1,
                });

                // Animación continua del botón formulario
                gsap.to("#boton-formulario-confirmar a", {
                    y: -3,
                    duration: 2,
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                    delay: 1,
                });

                console.log(
                    "💬✨ ¡Animaciones de confirmar asistencia activadas!",
                );
            });
        }
    </script>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 💬 MENSAJE PREDETERMINADO DE WHATSAPP                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <script>
        // El mensaje se arma solo acá: cambiar novios o fecha en estas líneas
        const NOVIOS = "Abimael y Nohelia";
        const FECHA = "19 de diciembre de 2026";

        function armarMensaje(nombre: string) {
            return (
                `¡Hola! Soy ${nombre}. Me complace confirmar mi asistencia ` +
                `a la boda de ${NOVIOS}, que se realizará el ${FECHA}. ` +
                `¡Ahí estaré! Muchas gracias.`
            );
        }

        const campo = document.getElementById(
            "nombre-invitado-confirmar",
        ) as HTMLInputElement | null;
        const aviso = document.getElementById("aviso-nombre-confirmar");
        const botones = document.querySelectorAll<HTMLAnchorElement>(
            ".btn-whatsapp-confirmar",
        );

        function actualizarEnlaces() {
            const nombre = campo?.value.trim() ?? "";
            botones.forEach((btn) => {
                const base = `https://wa.me/${btn.dataset.telefono}`;
                btn.href = nombre
                    ? `${base}?text=${encodeURIComponent(armarMensaje(nombre))}`
                    : base;
            });
            if (nombre) aviso?.classList.add("hidden");
        }

        campo?.addEventListener("input", actualizarEnlaces);

        // Sin nombre no se abre WhatsApp: se pide primero el nombre
        botones.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                if (campo && !campo.value.trim()) {
                    e.preventDefault();
                    aviso?.classList.remove("hidden");
                    campo.focus();
                    return;
                }
                // Se arma justo al tocar: cubre el autocompletado del navegador
                actualizarEnlaces();
            });
        });
    </script>

