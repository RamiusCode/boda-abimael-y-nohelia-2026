<!-- ═══════════════════════════════════════════════════════════ --><!-- 🎁 SECCIÓN: SUGERENCIA DE REGALES                           --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-16 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE MESA DE REGALOS -->
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-regalos">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-regalos">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-2xl shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-regalos"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo mesa regalos"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- VELO BLANCO: mismo tono que las tarjetas de NombresFlores -->
                    <div class="absolute inset-0 bg-white/40"></div>
                    <div
                        class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/20 to-transparent"
                    >
                    </div>

                    <!-- Contenido de la card -->
                    <div
                        class="relative px-4 pt-16 pb-12 z-10 flex flex-col items-center"
                    >
                        <!-- TÍTULO PRINCIPAL -->
                        <div class="text-center mb-6" id="titulo-regalos">
                            <h2
                                class="font-great-vibes text-[2.25rem] text-[#5E6B4A] leading-tight"
                            >
                                Sugerencia de Regalos
                            </h2>
                        </div>

                        <!-- TEXTO DESCRIPTIVO -->
                        <div class="text-center mb-8" id="texto-regalos">
                            <p
                                class="font-cormorant-sc text-lg text-[#5E6B4A] leading-relaxed"
                            >

                                Nuestra historia sigue creciendo y construimos
                                nuestro hogar desde la primera piedra. Tenerlos
                                ese día es el mejor regalo, y si desean
                                obsequiarnos algo para equiparlo, valoraremos
                                muchísimo cualquier detalle funcional o artículo
                                esencial para nuestra vida juntos.
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 🎬 ANIMACIONES CON GSAP - SOLO AL BAJAR                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        if (typeof window !== "undefined") {
            document.addEventListener("DOMContentLoaded", () => {
                // Animación del botón decorativo
                gsap.fromTo(
                    "#boton-decorativo-regalos",
                    {
                        opacity: 0,
                        scale: 0,
                        rotation: -180,
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "back.out(1.7)",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación de la card
                gsap.fromTo(
                    "#card-principal-regalos",
                    {
                        opacity: 0,
                        y: 50,
                        scale: 0.95,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del título
                gsap.fromTo(
                    "#titulo-regalos",
                    {
                        opacity: 0,
                        y: -20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del texto
                gsap.fromTo(
                    "#texto-regalos",
                    {
                        opacity: 0,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.2,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación de las direcciones
                gsap.fromTo(
                    "#direcciones",
                    {
                        opacity: 0,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.8,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );
            });
        }
    </script>
</section>
